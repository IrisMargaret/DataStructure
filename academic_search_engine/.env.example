# ============================================================
# 论文拆解 Agent 配置模板 —— 复制为 .env 后填写（.env 已被 gitignore）
# 未配置时系统自动使用规则拆解（全功能可用），无需删除本文件。
#
# 任意 OpenAI 兼容的 Chat Completions 服务均可：
#   LLM_API_BASE 形如 https://your-provider.com/v1（不含末尾斜杠）
#   LLM_MODEL    形如 your-model-name
# ============================================================
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
